# Variables du frontend (Vite) : seules celles préfixées VITE_ sont exposées au navigateur,
# et elles sont intégrées au bundle au moment du build (jamais de secret ici).

# URL de l'API backend
# En dev : si non défini, le proxy de vite.config.js envoie /api/* vers http://localhost:4000
# En prod (Vercel) : NE PAS définir. Le frontend appelle /api sur sa propre origine et vercel.json
# réécrit /api/* vers l'API Render : obligatoire pour le cookie de session (SameSite=Strict).
# VITE_API_URL=http://localhost:4000

# Google Maps : clé API pour l'autocomplétion de la destination (Places API)
# Créer une clé dans Google Cloud Console et activer "Places API" et "Maps JavaScript API"
VITE_GOOGLE_MAPS_API_KEY=votre_cle_google_maps
