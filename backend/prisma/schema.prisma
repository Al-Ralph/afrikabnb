generator client {
  provider = "prisma-client-js"
}

// PostgreSQL (Supabase en production). DATABASE_URL : pooler en mode transaction (port 6543,
// ?pgbouncer=true&connection_limit=1) utilisé par l'API ; DIRECT_URL : connexion directe ou
// session pooler (port 5432) utilisée par `prisma migrate` (DDL incompatibles avec le pooler).
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Longueurs VARCHAR alignées sur les schémas zod des routes (src/api/**/*.routes.js).

enum Role {
  GUEST
  HOST
  ADMIN
}

// PENDING : demande en attente de l'hôte (annonce sans réservation instantanée), expire après
// 48 h (voir src/utils/bookingStatus.js). DECLINED : refusée par l'hôte. EXPIRED : sans réponse.
enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  DECLINED
  EXPIRED
}

enum ListingStatus {
  ACTIVE
  HIDDEN
}

// Équipements (filtre ?amenities=WIFI,POOL : tous requis).
enum Amenity {
  WIFI
  AIR_CONDITIONING
  FAN
  POOL
  PARKING
  KITCHEN
  WASHER
  TV
  WORKSPACE
  GENERATOR
  SOLAR_POWER
  WATER_TANK
  WATER_HEATER
  SECURITY
  CCTV
  BREAKFAST
  SEA_VIEW
  BEACH_ACCESS
  GARDEN
  TERRACE
  BBQ
  MOSQUITO_NETS
  AIRPORT_SHUTTLE
  HOUSEKEEPING
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique @db.VarChar(254)
  password          String
  name              String?   @db.VarChar(100)
  avatar            String?   @db.VarChar(2048)
  role              Role      @default(GUEST)
  // Dernier changement / réinitialisation du mot de passe : les JWT émis avant sont refusés.
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  listings            Listing[]
  favorites           Favorite[]
  bookings            Booking[]
  reviews             Review[]
  passwordResetTokens PasswordResetToken[]
  refreshTokens       RefreshToken[]
}

model Listing {
  id            String        @id @default(cuid())
  title         String        @db.VarChar(200)
  description   String?       @db.VarChar(5000)
  location      String        @db.VarChar(200)
  address       String?       @db.VarChar(300)
  latitude      Float?
  longitude     Float?
  pricePerNight Decimal       @db.Decimal(10, 2)
  currency      String        @default("XOF") @db.VarChar(3)
  maxGuests     Int           @default(4)
  bedrooms      Int           @default(1)
  // Calculés à partir des avis (moyenne arrondie à 2 décimales) : jamais saisis par l'hôte.
  rating        Decimal?      @db.Decimal(3, 2)
  reviewCount   Int           @default(0)
  // Image de couverture = première ListingImage (synchronisée automatiquement), conservée pour
  // la compatibilité des clients existants.
  imageUrl      String?       @db.VarChar(2048)
  categoryId    String?       @db.VarChar(50)
  acceptsPets   Boolean       @default(false)
  amenities     Amenity[]     @default([])
  // false : les réservations sont créées en PENDING et doivent être acceptées par l'hôte.
  instantBook   Boolean       @default(true)
  // HIDDEN (modération) : invisible du public, visible par l'hôte et les admins.
  status        ListingStatus @default(ACTIVE)
  hostId        String
  host          User          @relation(fields: [hostId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  favorites      Favorite[]
  bookings       Booking[]
  reviews        Review[]
  images         ListingImage[]
  blockedPeriods BlockedPeriod[]

  @@index([latitude, longitude])
  @@index([hostId])
  @@index([categoryId])
  @@index([status])
}

model ListingImage {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String   @db.VarChar(2048)
  // Clé dans le stockage (null : image externe, ex. Unsplash, jamais supprimée du stockage).
  path      String?  @db.VarChar(512)
  position  Int      @default(0)
  alt       String?  @db.VarChar(200)
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  @@index([listingId, position])
}

// Dates bloquées par l'hôte : nuits [startDate, endDate[ (même convention que Booking).
model BlockedPeriod {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  reason    String?  @db.VarChar(200)
  createdAt DateTime @default(now())

  @@index([listingId, startDate, endDate])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@index([listingId])
}

model Booking {
  id         String        @id @default(cuid())
  listingId  String
  // null : réservation sans compte (voyageur identifié par sa fiche de contact et son jeton d'accès).
  guestId    String?
  listing    Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  guest      User?         @relation(fields: [guestId], references: [id], onDelete: Cascade)
  // Nuits occupées : [checkIn, checkOut[ (le jour du départ est libre pour une arrivée).
  checkIn    DateTime      @db.Date
  checkOut   DateTime      @db.Date
  guests     Int
  totalPrice Decimal       @db.Decimal(10, 2)
  status     BookingStatus @default(CONFIRMED)
  createdAt  DateTime      @default(now())

  // Fiche de contact saisie par le voyageur, transmise à l'hôte de l'annonce uniquement.
  // Nullable : réservations antérieures à la vague 4 (reprises depuis User par la migration).
  contactName    String?   @db.VarChar(100)
  // Normalisé en minuscules (quota des demandes sans compte par adresse).
  contactEmail   String?   @db.VarChar(254)
  contactPhone   String?   @db.VarChar(32)
  // Code pays ISO 3166-1 alpha-2.
  contactCountry String?   @db.VarChar(2)
  // Heure d'arrivée estimée "HH:MM".
  arrivalTime    String?   @db.VarChar(5)
  messageToHost  String?   @db.VarChar(1000)
  // Réservation sans compte : SHA-256 du jeton du lien de suivi (le jeton n'est jamais stocké).
  guestAccessTokenHash String?   @unique @db.Char(64)
  guestAccessExpiresAt DateTime?

  review Review?

  @@index([listingId, checkIn, checkOut])
  @@index([guestId])
  @@index([status, createdAt])
  @@index([contactEmail])
}

model Review {
  id        String   @id @default(cuid())
  listingId String
  authorId  String
  bookingId String   @unique
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String   @db.VarChar(1000)
  createdAt DateTime @default(now())

  @@index([listingId, createdAt])
  @@index([authorId])
}

// Jeton de réinitialisation du mot de passe : seul le hash SHA-256 est stocké (1 h, usage unique).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Jeton de renouvellement de session (cookie httpOnly afrikabnb_rt) : seul le hash SHA-256 est
// stocké. Rotation à chaque usage (l'ancien est révoqué, replacedById pointe vers le suivant) ;
// un jeton révoqué présenté à nouveau révoque toute sa famille (détection de réutilisation).
model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique @db.Char(64)
  familyId     String    @db.VarChar(64)
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?   @db.VarChar(255)

  @@index([userId])
  @@index([familyId])
}
