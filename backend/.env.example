# Copier vers .env et remplacer TOUTES les valeurs. Ne jamais versionner .env.

# Environnement : development | production
NODE_ENV=development

# Port de l'API
PORT=4000

# --- Base de données PostgreSQL ---
# Les deux URL sont lues par Prisma (prisma/schema.prisma) :
#   DATABASE_URL : utilisée par l'API (requêtes) ;
#   DIRECT_URL   : utilisée par `prisma migrate deploy` (création des tables).
# Mot de passe contenant des caractères spéciaux : l'encoder en URL
# (@ → %40, : → %3A, / → %2F, ? → %3F, # → %23, % → %25).
#
# Option A (recommandée) : Supabase
# Tableau de bord Supabase → bouton "Connect" (ou Project Settings → Database)
# → Connection string, onglet URI. Remplacer [YOUR-PASSWORD] par le mot de passe de la base.
#   DATABASE_URL = "Transaction pooler" (port 6543) + ?pgbouncer=true&connection_limit=1&sslmode=require
#   DIRECT_URL   = "Session pooler" (port 5432, compatible IPv4) ou "Direct connection"
#                  (db.<ref>.supabase.co:5432, IPv6 uniquement sans l'add-on IPv4) + ?sslmode=require
DATABASE_URL="postgresql://postgres.<project-ref>:<mot-de-passe-encode>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
DIRECT_URL="postgresql://postgres.<project-ref>:<mot-de-passe-encode>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"
#
# Option B : PostgreSQL local (docker compose up db) : même URL pour les deux variables.
# DATABASE_URL="postgresql://afrikabnb:exemple-mot-de-passe@localhost:5432/afrikabnb?schema=public"
# DIRECT_URL="postgresql://afrikabnb:exemple-mot-de-passe@localhost:5432/afrikabnb?schema=public"

# JWT : 32 caractères minimum, obligatoire en production.
# Générer avec : openssl rand -base64 48
JWT_SECRET="remplacer-par-la-sortie-de-openssl-rand-base64-48"
# Sessions. Jeton d'accès JWT (gardé en mémoire par le frontend) : secondes ou 15m, 1h...
# (JWT_EXPIRES_IN est obsolète et ignoré.)
JWT_ACCESS_TTL=15m
# Jeton de renouvellement (cookie httpOnly afrikabnb_rt, SameSite=Strict, Path=/api/auth), en jours.
REFRESH_TTL_DAYS=30
# Attribut Secure du cookie : toujours actif en production ; true pour le forcer ailleurs (HTTPS local).
# COOKIE_SECURE=true

# CORS : origines autorisées, séparées par des virgules (avec credentials). "*" interdit en production,
# ignoré en développement. En production, préférer un frontend en même origine (réécriture /api/*).
CORS_ORIGIN="http://localhost:3000"

# Logs (pino) : fatal | error | warn | info | debug | trace. Défaut : debug en développement, info sinon.
# Développement : sortie lisible (pino-pretty) ; production : JSON, une ligne par événement.
# LOG_LEVEL=info
# LOG_SQL=1 journalise toutes les requêtes SQL de Prisma (très verbeux, débogage uniquement).
# LOG_SQL=1

# Nombre de reverse proxys devant l'API (0 = aucun). Nécessaire pour un rate limiting
# correct derrière nginx / un load balancer.
TRUST_PROXY=0

# --- URL publiques ---
# Frontend : liens des emails (réinitialisation du mot de passe, réservations). OBLIGATOIRE en production.
APP_URL="http://localhost:3000"
# API : préfixe des URL d'images en stockage "local" (défaut : http://localhost:$PORT).
# PUBLIC_API_URL="http://localhost:4000"

# --- Stockage des photos ---
# local    : backend/uploads/ servi sous /uploads (développement ; refusé en production
#            sauf STORAGE_ALLOW_LOCAL=1 avec un volume persistant).
# supabase : Supabase Storage (défaut en production). Créer un bucket PUBLIC "listing-images".
STORAGE_DRIVER=local
# STORAGE_ALLOW_LOCAL=1
# Clés SERVEUR uniquement : ne jamais les mettre dans une variable VITE_* ni dans le frontend.
# Supabase → Project Settings → API : Project URL et clé "service_role" (ou clé secrète sb_secret_…).
# SUPABASE_URL="https://<project-ref>.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="remplacer-par-la-cle-service-role"
# SUPABASE_STORAGE_BUCKET=listing-images

# --- Emails transactionnels ---
# console : journalise les emails (et le lien de réinitialisation) sans rien envoyer (défaut en dev).
# resend  : API Resend (défaut en production). Sans RESEND_API_KEY, l'API démarre quand même et
#           journalise une erreur à chaque envoi.
EMAIL_DRIVER=console
# RESEND_API_KEY="re_remplacer_par_la_cle_resend"
# Expéditeur d'un domaine vérifié dans Resend (onboarding@resend.dev : tests vers votre propre adresse).
# EMAIL_FROM="AfrikaBnB <no-reply@votre-domaine.example>"

# --- Docker Compose (service db PostgreSQL local, facultatif) ---
# Mot de passe sans caractères spéciaux d'URL (il est inséré dans DATABASE_URL).
# Générer avec : openssl rand -hex 24
POSTGRES_DB=afrikabnb
POSTGRES_USER=afrikabnb
POSTGRES_PASSWORD=exemple-mot-de-passe

# Seed : compte ADMIN créé seulement si SEED_ADMIN_PASSWORD est défini (12 caractères minimum,
# ex. sortie de `openssl rand -base64 18`). Ne jamais réutiliser le mot de passe de démo.
# SEED_ADMIN_EMAIL="admin@afrikabnb.com"
# SEED_ADMIN_PASSWORD=""
