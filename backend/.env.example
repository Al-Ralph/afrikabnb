# Copier vers .env et remplacer TOUTES les valeurs. Ne jamais versionner .env.

# Environnement : development | production
NODE_ENV=development

# Port de l'API
PORT=4000

# --- Base de données PostgreSQL ---
# Les deux URL sont lues par Prisma (prisma/schema.prisma) :
#   DATABASE_URL : utilisée par l'API (requêtes) ;
#   DIRECT_URL   : utilisée par `prisma migrate deploy` (création des tables).
# Mot de passe contenant des caractères spéciaux : l'encoder en URL
# (@ → %40, : → %3A, / → %2F, ? → %3F, # → %23, % → %25).
#
# Option A (recommandée) : Supabase
# Tableau de bord Supabase → bouton "Connect" (ou Project Settings → Database)
# → Connection string, onglet URI. Remplacer [YOUR-PASSWORD] par le mot de passe de la base.
#   DATABASE_URL = "Transaction pooler" (port 6543) + ?pgbouncer=true&connection_limit=1&sslmode=require
#   DIRECT_URL   = "Session pooler" (port 5432, compatible IPv4) ou "Direct connection"
#                  (db.<ref>.supabase.co:5432, IPv6 uniquement sans l'add-on IPv4) + ?sslmode=require
DATABASE_URL="postgresql://postgres.<project-ref>:<mot-de-passe-encode>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
DIRECT_URL="postgresql://postgres.<project-ref>:<mot-de-passe-encode>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"
#
# Option B : PostgreSQL local (docker compose up db) : même URL pour les deux variables.
# DATABASE_URL="postgresql://afrikabnb:exemple-mot-de-passe@localhost:5432/afrikabnb?schema=public"
# DIRECT_URL="postgresql://afrikabnb:exemple-mot-de-passe@localhost:5432/afrikabnb?schema=public"

# JWT : 32 caractères minimum, obligatoire en production.
# Générer avec : openssl rand -base64 48
JWT_SECRET="remplacer-par-la-sortie-de-openssl-rand-base64-48"
# Durée de validité des tokens (format jsonwebtoken : 15m, 1h, 1d...)
JWT_EXPIRES_IN=1d

# CORS : origines autorisées, séparées par des virgules. "*" interdit en production.
CORS_ORIGIN="http://localhost:3000"

# Logs (pino) : fatal | error | warn | info | debug | trace. Défaut : debug en développement, info sinon.
# Développement : sortie lisible (pino-pretty) ; production : JSON, une ligne par événement.
# LOG_LEVEL=info
# LOG_SQL=1 journalise toutes les requêtes SQL de Prisma (très verbeux, débogage uniquement).
# LOG_SQL=1

# Nombre de reverse proxys devant l'API (0 = aucun). Nécessaire pour un rate limiting
# correct derrière nginx / un load balancer.
TRUST_PROXY=0

# --- Docker Compose (service db PostgreSQL local, facultatif) ---
# Mot de passe sans caractères spéciaux d'URL (il est inséré dans DATABASE_URL).
# Générer avec : openssl rand -hex 24
POSTGRES_DB=afrikabnb
POSTGRES_USER=afrikabnb
POSTGRES_PASSWORD=exemple-mot-de-passe
